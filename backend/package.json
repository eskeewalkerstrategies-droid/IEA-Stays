{
  "name": "ew-ops-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EskeeWalker Ops backend: queue, webhooks, Slack approvals, senders and the Ops MCP server",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@hono/node-server": "^1.19.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@slack/web-api": "^7.9.0",
    "hono": "^4.10.0",
    "imapflow": "^1.0.190",
    "mailparser": "^3.7.0",
    "nodemailer": "^7.0.0",
    "pg-boss": "^12.0.0",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
