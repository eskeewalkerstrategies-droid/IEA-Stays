# Copy to .env for local work. In production every value lives in Coolify's environment settings.
NODE_ENV=development
PORT=8080
PUBLIC_URL=http://localhost:8080
DATABASE_URL=postgres://ops:ops@localhost:5432/ops
LOG_LEVEL=info
TZ_NAME=Asia/Kolkata

# One token per person or agent: name:token,name:token (openssl rand -hex 32)
OPS_MCP_TOKENS=jitaksh:change-me,agent-followup:change-me-too

# Twenty CRM (leave empty to run without the CRM)
TWENTY_API_URL=
TWENTY_API_KEY=
TWENTY_WEBHOOK_SECRET=

# Slack (leave empty and messages print to the log)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVALS_CHANNEL=
SLACK_ALERTS_CHANNEL=

# Email out: smtp or log
MAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Jitaksh Jain <founder@example.com>
MAIL_REPLY_TO=
MAIL_SIGNATURE=Jitaksh
EskeeWalker Strategies

# Email in (shared inbox the Reply agent reads)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX

# Claude API for instant tasks on the server
ANTHROPIC_API_KEY=
CLAUDE_CLASSIFY_MODEL=claude-haiku-5-5
CLAUDE_TOOL_MODEL=claude-opus-5-5

# listmonk
LISTMONK_URL=
LISTMONK_USER=
LISTMONK_PASS=
LISTMONK_LIST_LEADS=
LISTMONK_LIST_CLIENTS=
LISTMONK_LIST_NEWSLETTER=

# Booking page
BOOKING_WEBHOOK_SECRET=
BOOKING_URL=https://cal.com/eskeewalker/strategy-call

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Lead form spam check (optional)
TURNSTILE_SECRET=

# Optional webhook to wake the Intake agent at once
AGENT_WAKE_URL=
AGENT_WAKE_TOKEN=

FILES_DIR=./data/files
BACKUP_STATUS_FILE=

# Phase 3
UMAMI_API_URL=
UMAMI_API_TOKEN=
UMAMI_WEBSITE_ID=
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=
