---
interface Props {
  title: string;
  description: string;
  canonical?: string;
}
const { title, description, canonical } = Astro.props;
const url = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Arimo:wght@400;700&family=Tinos:wght@700&display=swap" rel="stylesheet" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <header class="top">
      <a class="brand" href="/">EskeeWalker Strategies</a>
      <nav>
        <a href="/articles">Articles</a>
        <a href="/tools">Free tools</a>
        <a href="/contact" class="cta">Talk to us</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="foot">
      <div>EskeeWalker Strategies LLP · Jaipur, Rajasthan</div>
      <div><a href="/privacy">Privacy and consent</a></div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --dark: #1a1a16;
    --paper: #f6f6f1;
    --ink: #1e1e19;
    --muted: #60605b;
    --rule: #d6d6cf;
    --tint: #ebebe3;
    --lime: #a9c63f;
    --olive: #5c6b29;
    --serif: "Tinos", "Liberation Serif", Georgia, serif;
    --sans: "Arimo", "Liberation Sans", Arial, sans-serif;
  }
  * { box-sizing: border-box; }
  html { background: var(--paper); color: var(--ink); font-family: var(--sans); line-height: 1.6; }
  body { margin: 0; }
  h1, h2, h3 { font-family: var(--serif); line-height: 1.15; margin: 0 0 0.5em; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); }
  h2 { font-size: 1.6rem; margin-top: 2em; }
  p { margin: 0 0 1em; }
  a { color: var(--olive); }
  main { max-width: 760px; margin: 0 auto; padding: 32px 20px 64px; }
  .top { display: flex; justify-content: space-between; align-items: center; padding: 18px 20px; background: var(--dark); color: #f2f2ec; }
  .top .brand { color: #fff; font-weight: 700; text-decoration: none; }
  .top nav a { color: #c4c4bc; margin-left: 18px; text-decoration: none; }
  .top nav a.cta { color: var(--lime); border: 1px solid var(--lime); padding: 6px 12px; border-radius: 2px; }
  .foot { border-top: 1px solid var(--rule); padding: 20px; font-size: 0.85rem; color: var(--muted); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
  .eyebrow { font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--olive); font-weight: 700; }
  .lead { color: var(--muted); font-size: 1.1rem; }
  .callout { background: var(--dark); color: #f2f2ec; padding: 20px 24px; border-left: 4px solid var(--lime); margin: 24px 0; }
  .callout a { color: var(--lime); }
  .list { list-style: none; padding: 0; }
  .list li { padding: 12px 0; border-bottom: 1px solid var(--rule); }
  .list li a { text-decoration: none; color: var(--ink); font-weight: 700; }
  .list li .meta { color: var(--muted); font-size: 0.85rem; }
  form label { display: block; font-weight: 700; margin: 14px 0 4px; }
  form input, form textarea { width: 100%; padding: 10px; border: 1px solid var(--rule); background: #fff; font: inherit; }
  form textarea { min-height: 120px; }
  form .consent { display: flex; gap: 10px; align-items: flex-start; font-weight: 400; margin-top: 16px; }
  form .consent input { width: auto; margin-top: 4px; }
  form button { margin-top: 18px; background: var(--dark); color: var(--lime); border: 0; padding: 12px 20px; font: inherit; font-weight: 700; cursor: pointer; }
  form .notice { font-size: 0.85rem; color: var(--muted); background: var(--tint); padding: 12px; margin-top: 12px; }
  .hp { position: absolute; left: -9999px; }
  .result { background: #fff; border: 1px solid var(--rule); padding: 20px; white-space: pre-wrap; }
</style>
